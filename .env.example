# ── MercadoPago ─────────────────────────────────────────────
# Estas variables se configuran en el panel de Vercel/Netlify
# (NO se suben al repositorio).

# Token PRIVADO de MercadoPago. Lo usa SOLO el servidor (api/create-preference.ts).
# Se obtiene en: https://www.mercadopago.com.mx/developers/panel  → Credenciales
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Llave PÚBLICA (opcional, solo si en el futuro integras el Brick/tarjeta embebida).
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dominio público del sitio ya desplegado (para las URLs de retorno del pago).
PUBLIC_URL=https://tu-dominio.com
